= form_with(model: comment) do |form|
  - if comment.errors.any?
    %div{style: "color: red"}
      %h2
        = "#{pluralize(comment.errors.count, "erro")} impediram o comentário de ser salvo:"

      %ul
        - comment.errors.each do |error|
          %li= error.full_message

  %div
    %strong
      = current_user.name

  %div
    = form.label :content, "Comentário", class: "form-label"
    = form.text_area :content, class: "form-control", rows: 4

  = form.hidden_field :article_id

  %div.mt-3
    = form.submit "Comentar", class: "btn btn-primary"