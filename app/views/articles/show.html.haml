.container.py-5
  .row.justify-content-center
    .col-lg-8
      .card.shadow-sm.border-0
        .card-body.p-4
          %h1.fw-bold
            = @article.title

          %p.text-muted
            = @article.created_at.strftime("%d/%m/%Y")

          %hr

          %p
            = @article.content

          .mt-4.d-flex.gap-2
            = link_to "Voltar", articles_path, class: "btn btn-outline-secondary"

            = link_to new_comment_path(current_user), class: "btn btn-primary" do
              %i.bi.bi-chat-left-text.me-2
              Comentar
              
            = link_to user_path(current_user), data: { turbo_method: :delete, turbo_confirm: "Tem certeza que deseja excluir sua conta?" }, class: "btn btn-danger" do
              %i.bi.bi-trash.me-2
              Excluir

          %hr.mt-5

          #comentarios
            %h4.fw-bold.mb-3
              Comentários

            %p.text-muted
              Ainda não há comentários.