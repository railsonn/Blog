
.container.py-5
  / Cabeçalho
  .d-flex.justify-content-between.align-items-center.mb-5
    %div
      %h1.display-6.fw-bold.mb-2 Artigos
      %p.text-muted.mb-0 Confira as últimas publicações do blog.

    %button.btn.btn-primary.px-4.py-2{"data-bs-target" => "#newArticleModal", "data-bs-toggle" => "modal", type: "button"}
      %i.bi.bi-plus-lg.me-2
      Novo artigo

  / Lista de artigos
  - if @articles.any?
    .row
      - @articles.each do |article|

        .col-md-4.mb-4
          .card.h-100.shadow-sm
            .card-body.d-flex.flex-column
              %h4.card-title
                = article.title

              %p.card-text.text-secondary
                = truncate(article.content, length: 130)

              .mt-auto.pt-4.border-top
                .d-flex.justify-content-between.align-items-center
                  %small.text-muted
                    %i.bi.bi-calendar3.me-1
                    = article.created_at.strftime("%d/%m/%Y")

                  = link_to article_path(article), class: "btn btn-outline-primary btn-sm px-3" do
                    Ler mais
                    %i.bi.bi-arrow-right.ms-1

  - else
    .text-center.py-5
      %i.bi.bi-journal-text.display-1.text-muted

      %h4.fw-bold.mt-3 Nenhum artigo encontrado

      %p.text-muted.mb-4
        Seja o primeiro a publicar um artigo!

      %button.btn.btn-primary.px-4{"data-bs-target" => "#newArticleModal", "data-bs-toggle" => "modal", type: "button"}
        %i.bi.bi-plus-lg.me-2
        Criar primeiro artigo

  / Modal
  #newArticleModal.modal.fade{"aria-hidden" => "true", "aria-labelledby" => "newArticleModalLabel", tabindex: "-1"}
    .modal-dialog.modal-lg.modal-dialog-centered
      .modal-content.border-0.shadow
        .modal-header
          %h1#newArticleModalLabel.modal-title.fs-5.fw-bold
            %i.bi.bi-pencil-square.me-2
            Novo artigo

          %button.btn-close{type: "button", "aria-label": "Fechar", "data-bs-dismiss": "modal"}

        .modal-body.p-4
          = form_with model: Article.new, local: true do |form|
            .mb-4
              = form.label :title, "Título", class: "form-label fw-semibold"
              = form.text_field :title, class: "form-control form-control-lg", placeholder: "Digite o título do artigo"

            .mb-4
              = form.label :content, "Conteúdo", class: "form-label fw-semibold"
              = form.text_area :content, rows: 10, class: "form-control", placeholder: "Escreva o conteúdo do artigo..."

            .d-flex.justify-content-end.gap-2.pt-3.border-top
              %button.btn.btn-light{"data-bs-dismiss" => "modal", type: "button"}
                Cancelar

              = form.submit "Publicar artigo", class: "btn btn-primary px-4"
```
